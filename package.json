{
  "name": "inboxclinic",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @inboxclinic/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "./scripts/ci-checks.sh && ./scripts/doc-sync-validate.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "4.9.0",
    "globals": "^17.7.0",
    "knip": "6.32.2",
    "prettier": "^3.9.5",
    "tldts": "7.4.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  }
}
